@startuml
!include style.iuml
left to right direction
actor "UT-02\nDBA" as DBA
actor "UT-01\nDatabase Developer" as DEV
actor "UT-06\nSQL Server" as SQL
rectangle "Snapshots" {
  usecase "UC-11 Export a snapshot" as UC11
  usecase "UC-17 Compare against a snapshot" as UC17
  usecase "UC-02 Extract a schema" as UC02
}
DBA --> UC11
DEV --> UC17
UC11 ..> UC02 : <<include>>
UC17 ..> UC02 : <<include>>
UC02 --> SQL
@enduml
