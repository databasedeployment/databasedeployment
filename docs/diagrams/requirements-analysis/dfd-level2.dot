digraph L2 {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.6, pad=0.15, newrank=true];
  node  [fontname="DejaVu Sans", fontsize=11, color="#1F3A5F"];
  edge  [fontname="DejaVu Sans", fontsize=8.5, color="#3A4F6B", fontcolor="#222222"];

  node [shape=box, style="", width=1.3, height=0.5];
  E1a [label="E1 User"];
  E1b [label="E1 User *"];
  P4  [shape=box, style="rounded,dashed", label="4.0\nAnalyze\ndeployment risk"];
  P6  [shape=box, style="rounded,dashed", label="6.0\nExecute scripts\nand migrations"];

  node [shape=box, style="rounded,filled", fillcolor="#EEF3F9", width=1.5, height=0.7];
  P51 [label="5.1\nResolve selection\nand direction"];
  P52 [label="5.2\nOrder by\ndependency"];
  P53 [label="5.3\nWrite object\nstatements"];
  P54 [label="5.4\nApply safe mode"];
  P55 [label="5.5\nGenerate rollback\nstatements"];
  P56 [label="5.6\nAssemble\ntransaction scripts"];

  node [shape=plaintext, style="", width=0, height=0];
  D4 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TBL" BORDER="1" COLOR="#1F3A5F">D4</TD><TD SIDES="TB" BORDER="1" COLOR="#1F3A5F">Comparison sessions</TD></TR></TABLE>>];
  D4b [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TBL" BORDER="1" COLOR="#1F3A5F">D4</TD><TD SIDES="TB" BORDER="1" COLOR="#1F3A5F">Comparison sessions *</TD></TR></TABLE>>];
  D5 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TBL" BORDER="1" COLOR="#1F3A5F">D5</TD><TD SIDES="TB" BORDER="1" COLOR="#1F3A5F">Migration files</TD></TR></TABLE>>];
  {rank=same; E1a; D4;}
  {rank=same; P51; }
  {rank=same; P52; P55; D4b;}
  {rank=same; P53; P4;}
  {rank=same; P54;}
  {rank=same; P56; E1b;}
  {rank=same; P6; D5;}

  E1a -> P51 [label="object selection,\ndirection"];
  D4 -> P51 [label="comparison result"];
  P51 -> P52 [label="selected changes"];
  P51 -> P55 [label="selected changes"];
  D4b -> P52 [label="reference graph"];
  D4b -> P53 [label="snapshot sub-parts"];
  D4b -> P55 [label="target definitions"];
  P52 -> P53 [label="ordered changes"];
  P52 -> P56 [label="cycle warning"];
  P53 -> P54 [label="statements"];
  P4 -> P54 [label="risk findings"];
  E1a -> P54 [label="safe mode"];
  P54 -> P56 [label="kept statements,\nexcluded steps"];
  P55 -> P56 [label="rollback statements"];
  P56 -> E1b [label="deployment and\nrollback scripts"];
  P56 -> P6 [label="deployment script"];
  P56 -> D5 [label="migration pair"];
}
