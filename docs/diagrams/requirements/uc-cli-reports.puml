@startuml
!include style.iuml
left to right direction
actor "UT-03\nBI / ETL Developer" as BI
actor "UT-04\nRelease Manager" as RM
actor "UT-05\nCI/CD pipeline" as CI
rectangle "Command line and reports" {
  usecase "UC-10 Run comparison jobs from the CLI" as UC10
  usecase "Select jobs by expression" as SEL
  usecase "UC-12 Export a report" as UC12
}
BI --> UC10
CI --> UC10
RM --> UC12
CI --> UC12
UC10 ..> SEL : <<include>>
UC12 ..> UC10 : <<extend>>
@enduml
