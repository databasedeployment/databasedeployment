@startuml
!include style.iuml
left to right direction
skinparam nodesep 6
skinparam ranksep 70
actor "UT-01\nDatabase Developer" as DEV
actor "UT-02\nDBA" as DBA
actor "UT-03\nBI / ETL Developer" as BI
actor "UT-04\nRelease Manager" as RM
actor "UT-05\nCI/CD pipeline" as CI <<system>>
actor "UT-06\nSQL Server" as SQL <<system>>
actor "UT-07\nAI provider" as AI <<system>>

rectangle "SchemaDiff" {
  usecase "UC-01 Connect to a database" as UC01
  usecase "UC-02 Extract a schema" as UC02
  usecase "UC-03 Configure comparison options" as UC03
  usecase "UC-04 Compare two databases" as UC04
  usecase "UC-05 Review rename candidates" as UC05
  usecase "UC-06 Generate a deployment script" as UC06
  usecase "UC-07 Analyze deployment risk" as UC07
  usecase "UC-08 Create and apply a migration" as UC08
  usecase "UC-09 Execute a deployment script" as UC09
  usecase "UC-10 Run comparison jobs from the CLI" as UC10
  usecase "UC-11 Compare against a snapshot" as UC11
  usecase "UC-12 Export a report" as UC12
  usecase "UC-13 Review differences in the web interface" as UC13
  usecase "UC-14 Get AI explanations" as UC14
  usecase "UC-15 Verify a change in the pipeline" as UC15
  usecase "UC-16 Get started with the documentation" as UC16
}

DEV --> UC01
DEV --> UC03
DEV --> UC04
DEV --> UC06
DEV --> UC08
DEV --> UC11
DEV --> UC13
DEV --> UC15
DBA --> UC01
DBA --> UC07
DBA --> UC09
DBA --> UC11
DBA --> UC13
BI --> UC05
BI --> UC10
RM --> UC08
RM --> UC12
RM --> UC14
RM --> UC16
CI --> UC10
CI --> UC12
CI --> UC15
UC04 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>
UC06 ..> UC07 : <<include>>
UC02 --> SQL
UC08 --> SQL
UC09 --> SQL
UC14 --> AI
@enduml
