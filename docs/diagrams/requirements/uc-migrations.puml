@startuml
!include style.iuml
left to right direction
actor "UT-01\nDatabase Developer" as DEV
actor "UT-04\nRelease Manager" as RM
actor "UT-06\nSQL Server" as SQL
rectangle "Migrations" {
  usecase "UC-08 Create and apply a migration" as UC08
  usecase "Save versioned migration" as SV
  usecase "Apply pending migrations" as AP
  usecase "Detect drift" as DR
}
DEV --> UC08
RM --> UC08
UC08 ..> SV : <<include>>
AP ..> UC08 : <<extend>>
DR ..> UC08 : <<extend>>
AP --> SQL
DR --> SQL
@enduml
